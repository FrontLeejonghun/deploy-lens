{
  "name": "deploy-lens",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/*.integration.mjs",
    "dev": "node server/index.mjs",
    "build": "tsc --noEmit && vite build && node scripts/prepare-chromium.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "check": "tsc --noEmit && node --check server/index.mjs && node --check server/capture.mjs",
    "lint": "oxlint --deny-warnings src server api",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@sparticuz/chromium": "^152.0.0",
    "express": "^5.1.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
